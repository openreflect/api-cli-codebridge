# Claude Code OpenAI-compatible server
CODEBRIDGE_CLAUDE_CWD=.
CLAUDE_PROXY_HOST=127.0.0.1
CLAUDE_PROXY_PORT=8082

# Optional direct path to an installed Claude ACP adapter.
# Leave empty to fall back to npx.
CLAUDE_AGENT_ACP_BIN=

# Vertex/Gemini OpenAI-style proxy
GOOGLE_APPLICATION_CREDENTIALS=./path/to/vertex-service-account.json
GOOGLE_CLOUD_PROJECT=YOUR_PROJECT_ID
VERTEX_MODEL=gemini-3.1-pro-preview
VERTEX_PROXY_HOST=127.0.0.1
VERTEX_PROXY_PORT=8091
VERTEX_PROXY_SCRIPT=./wrappers/gemini-vertex/vertex-token-proxy.mjs
VERTEX_PROXY_RUN_DIR=./.codebridge/run
VERTEX_PROXY_LOG_DIR=./.codebridge/logs
